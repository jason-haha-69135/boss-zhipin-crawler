# =====================================================================
# BOSS Zhipin Job Intelligence Agent & Eval Suite — Environment Example
# Copy this file to `.env` and fill in your credentials (NEVER commit `.env`)
# =====================================================================

# --- Option A: Google AI Studio API Key ---
GEMINI_API_KEY=

# --- Option B: Google Cloud Vertex AI (Application Default Credentials) ---
# Run `gcloud auth application-default login` before starting if using Vertex AI
GOOGLE_CLOUD_PROJECT=
GCLOUD_ACCOUNT=

# --- Model Configuration (Pipeline: gemini-3.8-flash | Eval Judge: gemini-4-argon) ---
STAGE1_EXTRACT_MODEL=gemini-3.8-flash
STAGE2_QUERY_MODEL=gemini-3.8-flash
STAGE3_INTENT_MODEL=gemini-3.8-flash
STAGE3_TEMPERATURE=0.1
STAGE5_ANALYSIS_MODEL=gemini-3.8-flash
STAGE5_TEMPERATURE=0.2
LLM_JUDGE_MODEL=gemini-4-argon

# --- Optional Local HTTP Proxy (leave blank if direct access works) ---
HTTPS_PROXY=
